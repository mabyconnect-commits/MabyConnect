# ============================================================
# Maby Connect — environment variables
#
# Copy to .env.local for development, and set the same keys in your
# hosting provider (Vercel → Settings → Environment Variables) for
# production. Everything here is optional: without it the site runs
# and forms accept submissions, they just log instead of emailing.
# ============================================================

# --- Site ---------------------------------------------------
# Your canonical domain. Drives metadata, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://mabyconnect.site


# --- Email delivery (contact form, project briefs, bookings) -
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Must be a sender on a domain you've verified with Resend.
AGENCY_FROM_EMAIL="Maby Agency <build@mabyconnect.com>"

# Where new enquiries land. Defaults to AGENCY_FROM_EMAIL when unset.
AGENCY_NOTIFY_EMAIL=build@mabyconnect.com


# --- Client portal ------------------------------------------
# Signs the portal session cookie. Generate one with:
#   openssl rand -base64 32
PORTAL_SESSION_SECRET=

# Active client logins, as JSON. `workspace` must match a key in
# the workspaces registry in src/lib/portal.ts.
# PORTAL_CLIENTS='[{"code":"NW-4821","workspace":"northwind","label":"Northwind Labs"}]'

# Set to 1 to switch off the public MABY-DEMO tour login.
# PORTAL_DISABLE_DEMO=1


# --- Maby AI assistant -------------------------------------
# Powers the web chat widget, the Telegram bot and WhatsApp.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=


# --- Telegram channel ---------------------------------------
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Any long random string. Telegram echoes it back on every webhook
# call so the route can prove the request really came from Telegram.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Register the webhook once both are set and you've redeployed — open
# this in any browser, phone included. Without it Telegram has nowhere
# to deliver messages and the bot stays silent.
#   /api/telegram/setup?secret=<TELEGRAM_WEBHOOK_SECRET>


# --- WhatsApp channel ---------------------------------------
# Meta Business → your app → WhatsApp → API setup.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Any string you choose; Meta echoes it during webhook setup.
WHATSAPP_VERIFY_TOKEN=

# App secret, used to verify Meta's request signatures.
WHATSAPP_APP_SECRET=
